# --- Public (safe for the browser) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# --- Server only. NEVER prefix with NEXT_PUBLIC_ ---
SUPABASE_SERVICE_ROLE_KEY=
TURNSTILE_SECRET_KEY=
# 32 random bytes, base64 (openssl rand -base64 32). Use a KMS/Vault in production.
ORBITA_MASTER_KEY=
# Shared rate limiting (required in production; in-memory fallback in dev)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Invitation emails (required in production)
RESEND_API_KEY=
EMAIL_FROM="Orbita <no-reply@yourdomain.com>"
ANTHROPIC_API_KEY=
