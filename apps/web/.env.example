# --- Public (safe for the browser) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# --- Server only. NEVER prefix with NEXT_PUBLIC_ ---
SUPABASE_SERVICE_ROLE_KEY=
TURNSTILE_SECRET_KEY=
# 32 random bytes, base64 (openssl rand -base64 32). Use a KMS/Vault in production.
ORBITA_MASTER_KEY=
# Shared rate limiting (required in production; in-memory fallback in dev)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Invitation emails (required in production)
RESEND_API_KEY=
EMAIL_FROM="Orbita <no-reply@yourdomain.com>"
ANTHROPIC_API_KEY=
# ORBITA_AGENT_MODEL=claude-opus-5-5
# ORBITA_LEARN_MODEL=claude-haiku-4-5
# AGENT_DAILY_TOKEN_CAP=500000
# AGENT_WEB_SEARCH=off

# --- Social connectors (docs/connectors.md) ---
# NEXT_PUBLIC_APP_URL must be the https URL users reach (used for OAuth redirect URIs)
META_APP_ID=
META_APP_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# 16+ random characters. Protects the scheduled sync endpoint (Vercel Cron sends it as a bearer token)
CRON_SECRET=
# Development only (ignored in production): generated data instead of real accounts
# CONNECTORS_FAKE=1
