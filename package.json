{
  "name": "orbita",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": { "node": ">=20" },
  "scripts": {
    "dev": "pnpm --filter @orbita/web dev",
    "build": "pnpm --filter @orbita/web build",
